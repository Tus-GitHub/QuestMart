# Copy to .env.local. Never commit real values.
# Run npm run db:local:setup for an isolated local PostgreSQL instance.
# For hosted PostgreSQL, use the provider's connection string with TLS enabled.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/questmart_demo
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Optional RAWG catalog integration. Seller inventory will be independent of this.
NEXT_PUBLIC_ROWG_KEY=
